# Copy to .env on the VPS. Never commit the real .env.
DB_NAME=benevixit
DB_USER=benevixit
DB_PASSWORD=CHANGE_ME_LONG_RANDOM
DB_ROOT_PASSWORD=CHANGE_ME_DIFFERENT_LONG_RANDOM

# Same value as the Worker's GRANT_SECRET — lets the mu-plugin verify passes.
BV_GRANT_SECRET=CHANGE_ME_MATCHES_WORKER_SECRET
