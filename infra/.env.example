# Copy to .env on the VPS. Never commit the real .env.
DB_NAME=benevixit
DB_USER=benevixit
DB_PASSWORD=CHANGE_ME_LONG_RANDOM
DB_ROOT_PASSWORD=CHANGE_ME_DIFFERENT_LONG_RANDOM

# Same value as the Worker's GRANT_SECRET — lets the mu-plugin verify passes.
BV_GRANT_SECRET=CHANGE_ME_MATCHES_WORKER_SECRET

# The origin lock (Caddyfile): derived from BV_GRANT_SECRET, never typed by
# hand. Generate it with the command in infra/README.md, "Hardening". Unset,
# the origin refuses every request.
BV_PROXY_TOKEN=

# Outbound mail (order emails). Authenticated SMTP at any provider; leave
# BV_SMTP_HOST empty to send nothing. 587 = STARTTLS, 465 = implicit TLS.
# After editing: `docker compose up -d` (env is fixed at container creation).
BV_SMTP_HOST=
BV_SMTP_PORT=587
BV_SMTP_USER=
BV_SMTP_PASS=
BV_MAIL_FROM=shopkeeper@benevixit.com
BV_MAIL_FROM_NAME=bene vixit
