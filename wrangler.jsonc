{
  "name": "benevixit",
  "main": "src/index.js",
  "compatibility_date": "2026-06-01",

  // Custom domains — Cloudflare creates the DNS records and certs on deploy.
  "routes": [
    { "pattern": "benevixit.com", "custom_domain": true },
    { "pattern": "www.benevixit.com", "custom_domain": true }
  ],

  // Static frontend lives in ./public, but EVERY request enters the Worker
  // first (src/index.js): /gate/* is handled there; for other paths GET/HEAD
  // try env.ASSETS and fall through to the WordPress origin on a miss, and
  // all non-GET/HEAD traffic (checkout AJAX, admin-ajax, webhooks, payment
  // callbacks) is proxied straight to WordPress. With the asset layer in
  // front (a path list here), a POST to a path that exists as an asset —
  // e.g. POST /?wc-ajax=update_order_review, whose path is "/" — was
  // answered by Cloudflare with an empty 405 before the Worker ever ran.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  // Workers AI — all calls routed through the AI Gateway (see GATEWAY_ID below).
  "ai": { "binding": "AI" },

  // The keeper's library (src/gate/library.js): Cloudflare AI Search over
  // the markdown in knowledge/. The instance must exist before this deploys.
  "ai_search": [{ "binding": "KEEPER_LIBRARY", "instance_name": "keeper-library" }],

  // Workers Logs — invocation logs + console.error from the DO, viewable in the dashboard.
  "observability": { "enabled": true },

  // Low-churn config only: gate manifest, current passphrase.
  // Mutable counters live in rate limiters and the GateSession DO, never KV.
  "kv_namespaces": [
    { "binding": "GATE_KV", "id": "4c8c540f919d4d6492012b332d9dc322" }
  ],

  // One Durable Object per gate conversation: transcript, turn count, verdicts.
  "durable_objects": {
    "bindings": [{ "name": "GATE_SESSION", "class_name": "GateSession" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GateSession"] }],

  // Per-IP rate limits. KV can't do this (eventually consistent, 1 write/sec/key).
  "unsafe": {
    "bindings": [
      {
        "name": "SESSION_RL",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 5, "period": 60 }
      },
      {
        "name": "MESSAGE_RL",
        "type": "ratelimit",
        "namespace_id": "1002",
        "simple": { "limit": 30, "period": 60 }
      }
    ]
  },

  "vars": {
    "GATEWAY_ID": "benevixit-gate",
    "SHOP_ORIGIN": "https://shop.benevixit.com",
    "TURNSTILE_SITE_KEY": "0x4AAAAAADyqZ5T9EIEi14YR"
  }

  // Secrets (set via `wrangler secret put <NAME>`, or .dev.vars locally):
  //   GRANT_SECRET     — HMAC key for access grants (shared with the WP mu-plugin)
  //   TURNSTILE_SECRET — Turnstile siteverify secret
}
